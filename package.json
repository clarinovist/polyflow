{
    "name": "polyflow",
    "version": "1.10.0",
    "private": true,
    "scripts": {
        "dev": "npm run db:sync:prod && npx prisma generate && next dev",
        "db:sync:prod": "chmod +x scripts/sync-db-prod.sh && ./scripts/sync-db-prod.sh",
        "dev:db": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d db",
        "dev:up": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up",
        "dev:up:build": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up --build",
        "dev:down": "docker compose -f docker-compose.yml -f docker-compose.dev.yml down",
        "db:generate": "npx prisma@5.22.0 generate",
        "db:migrate:deploy": "npx prisma@5.22.0 migrate deploy",
        "db:migrate:status": "npx prisma@5.22.0 migrate status",
        "db:seed": "npx prisma@5.22.0 db seed",
        "build": "next build",
        "build:assistant-worker": "node scripts/build-assistant-worker.mjs",
        "typecheck:assistant-worker": "tsc -p tsconfig.worker.json --noEmit",
        "start": "next start",
        "start:assistant-worker": "node dist/assistant-worker/index.mjs",
        "backup:assistant-worker": "node scripts/backup-assistant-sqlite.mjs",
        "lint": "eslint",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:run": "vitest run",
        "test:coverage": "vitest run --coverage",
        "audit:production-voids": "node scripts/audit-duplicate-production-voids.js",
        "repair:maklon-sales-locations": "node scripts/repair-maklon-sales-order-locations.js"
    },
    "prisma": {
        "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1156.0",
        "@aws-sdk/s3-request-presigner": "^3.1156.0",
        "@earendil-works/chord": "1.4.0",
        "@earendil-works/pi-ai": "1.4.0",
        "@earendil-works/pi-durable": "1.4.0",
        "@hookform/resolvers": "^5.9.2",
        "@prisma/client": "^5.22.0",
        "@radix-ui/react-accordion": "^1.3.1",
        "@radix-ui/react-alert-dialog": "^1.2.1",
        "@radix-ui/react-checkbox": "^1.4.1",
        "@radix-ui/react-dialog": "^1.3.1",
        "@radix-ui/react-dropdown-menu": "^2.2.1",
        "@radix-ui/react-label": "^2.1.17",
        "@radix-ui/react-popover": "^1.3.1",
        "@radix-ui/react-progress": "^1.2.1",
        "@radix-ui/react-select": "^2.4.1",
        "@radix-ui/react-separator": "^1.2.0",
        "@radix-ui/react-slot": "^1.5.0",
        "@radix-ui/react-switch": "^1.4.1",
        "@radix-ui/react-tabs": "^1.2.1",
        "@radix-ui/react-tooltip": "^1.4.1",
        "@react-email/render": "^2.1.1",
        "@tanstack/react-table": "^8.21.3",
        "bcryptjs": "^3.0.3",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "date-fns": "^4.4.0",
        "framer-motion": "^12.43.0",
        "leaflet": "^1.9.4",
        "lucide-react": "^1.61.0",
        "next": "16.4.3",
        "next-auth": "^5.0.0-beta.32",
        "node-domexception": "file:vendor/node-domexception",
        "openai": "^6.49.0",
        "papaparse": "^5.7.0",
        "pg": "^8.23.1",
        "radix-ui": "^1.8.1",
        "react": "19.3.1",
        "react-day-picker": "^9.13.0",
        "react-dom": "19.3.1",
        "react-hook-form": "^7.91.0",
        "react-is": "^19.3.1",
        "recharts": "^3.10.1",
        "resend": "^6.34.1",
        "sonner": "^2.0.8",
        "swr": "^2.5.1",
        "tailwind-merge": "^3.7.0",
        "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
        "zod": "^4.5.2"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4",
        "@testing-library/react": "^16.3.3",
        "@types/leaflet": "^1.9.22",
        "@types/node": "^20.19.43",
        "@types/papaparse": "^5.5.2",
        "@types/pg": "^8.23.1",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "@vitest/coverage-v8": "4.1.12",
        "eslint": "^9",
        "eslint-config-next": "16.4.3",
        "jsdom": "^29.1.1",
        "prisma": "^5.22.0",
        "tailwindcss": "^4",
        "ts-morph": "^28.0.0",
        "ts-node": "^10.9.2",
        "tw-animate-css": "^1.4.0",
        "typescript": "^6",
        "vitest": "4.1.12"
    },
    "allowScripts": {
        "esbuild@0.28.2": true,
        "prisma@5.22.0": true,
        "protobufjs@7.6.6": true,
        "unrs-resolver@1.11.1": true,
        "@prisma/engines@5.22.0": true,
        "@prisma/client@5.22.0": true,
        "@google/genai": false,
        "fsevents": false
    }
}
