{
    "$schema": "https://unpkg.com/knip@6/schema.json",
    "entry": [
        "scripts/**/*.{ts,js,mjs,cjs}",
        "!scripts/archive/**",
        "src/scripts/**/*.ts",
        "prisma/*.ts",
        "workers/**/index.ts",
        "public/sw.js",
        "src/app/my/manifest.ts",
        "src/**/__tests__/**/*.mjs"
    ],
    "ignore": ["vendor/**", "scripts/archive/**"],
    "ignoreIssues": {
        "src/components/ui/**": ["exports", "types"],
        "src/services/purchasing/__tests__/gr-valuation-postgres-fixture.ts": [
            "exports"
        ],
        "src/services/sales/__tests__/shipment-reversal-postgres-fixture.ts": [
            "exports"
        ],
        "src/actions/production/production-orders.ts": ["duplicates"],
        "src/lib/schemas/inventory.ts": ["duplicates"],
        "src/lib/schemas/sales.ts": ["duplicates"]
    },
    "ignoreDependencies": ["node-domexception", "ts-morph"],
    "ignoreExportsUsedInFile": true
}
