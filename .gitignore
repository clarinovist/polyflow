/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.pytest_cache/
/.ruff_cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
**/.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel
.agent
.claude/
.gemini
.hermes/

# typescript
*.tsbuildinfo
next-env.d.ts

# local databases
prisma/*.db
prisma/*.db-journal
prisma/*.db-shm
prisma/*.db-wal

# backups
/backups/

# openclaw & Agent data
.openclaw
.openclaw/
# NOTE: AGENTS.md is intentionally NOT ignored — the repo tracks module-level
# AGENTS.md docs (root, .agents/, src/**/) enforced by scripts/check-agents-consistency.sh.
BOOTSTRAP.md
HEARTBEAT.md
IDENTITY.md
SOUL.md
TOOLS.md
USER.md
MEMORY.md
memory/

# local codex/import working files
.codex/
import_production.py
import_rafia_hasil_produksi_safe.py
rafia-import-log-*.md
rafra-spreadsheet-mapping.md

# generated code graph / Graphify artifacts
.codegraph/
graphify-out/

# Vendored agent-skill docs installed by `graphify install --platform opencode`.
# Third-party docs, re-created by the installer, and they pollute the graph corpus
# (they get re-extracted as "changed documents" on every sync). plugins/ stays
# tracked so collaborators get the same setup.
/.opencode/skills/
# Contains plaintext API keys — must NOT be committed.
/.opencode/opencode.json

# local planning/working docs — kept out of this public repo on purpose.
# Plans routinely carry internal detail (host addresses, account emails, tenant
# names), so docs/plan/ stays local-only. AGENTS.md still requires a plan file
# per change; it just is not committed.
# Pattern is /docs/plan/* (not /docs/plan/) so the negation below can re-include
# one entry — git cannot re-include a file whose parent directory is excluded.
/docs/plan/*
!/docs/plan/_TEMPLATE.md
/docs/marketing/
.gstack/

# throwaway HTML UI sketches (local only)
/sketches/

# Melindo data-migration working set — real customer and supplier records.
# 146 customer names with phone numbers, addresses and NPWP; 53 suppliers with
# 23 bank account numbers; AR/AP balances per counterparty. This is Melindo's
# data, not ours, and it is personal data under UU PDP 27/2022 — it must not sit
# in a public repo. Kept locally because the import narrative is still useful.
# NOTE: ignoring only stops future exposure. These files are still in git history
# (added 2026-07-03, c9f383b2) and in existing forks; removing them from history
# needs a rewrite + force push and cannot reach the forks.
/docs/data-import/archive/melindo-initial/
/melindo_sales_import.sql
/melindo_catalog_review.csv
