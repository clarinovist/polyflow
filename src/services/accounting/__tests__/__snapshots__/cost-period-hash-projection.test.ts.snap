exports[`schema changes require an explicit cost hash projection decision > pins six entire model contracts and their enums; review the decision doc before updating 1`] = `
{
  "AccountType": [
    "ASSET",
    "LIABILITY",
    "EQUITY",
    "REVENUE",
    "EXPENSE",
  ],
  "JournalEntry": [
    "id String @id @default(uuid())",
    "entryNumber String @unique",
    "entryDate DateTime",
    "description String",
    "reference String?",
    "referenceType ReferenceType?",
    "referenceId String?",
    "status JournalStatus @default(DRAFT)",
    "isAutoGenerated Boolean @default(false)",
    "createdById String?",
    "approvedById String?",
    "approvedAt DateTime?",
    "createdAt DateTime @default(now())",
    "updatedAt DateTime @updatedAt",
    "approvedBy User? @relation("JournalApprover", fields: [approvedById], references: [id])",
    "createdBy User? @relation("JournalCreator", fields: [createdById], references: [id])",
    "lines JournalLine[]",
    "internalUsage InternalUsage?",
    "atkSourceCorrections AtkCostCorrection[] @relation("AtkCorrectionOriginal")",
    "atkCorrectionPosting AtkCostCorrection? @relation("AtkCorrectionPosting")",
    "atkEvidence AtkCostEvidence[] @relation("AtkEvidenceJournal")",
    "details JournalEntryDetail[]",
    "pettyCashTransaction PettyCashTransaction?",
    "reconciliationAdjustments BankReconciliationAdjustment[]",
    "priceAdjustmentSources InvoicePriceAdjustment[] @relation("PriceAdjustmentSource")",
    "priceAdjustmentJournal InvoicePriceAdjustment? @relation("PriceAdjustmentJournal")",
    "priceAdjustmentReversal InvoicePriceAdjustment? @relation("PriceAdjustmentReversal")",
    "purchasePriceCorrection PurchasePriceCorrection?",
    "manualReturnAllocations SalesReturnCreditAllocation[] @relation("ManualReturnSourceJournal")",
    "returnBasisLines InvoiceReturnBasisLine[]",
    "returnCredit SalesReturnCredit?",
    "returnReceipt SalesReturnReceiptLine?",
    "returnCreditReversal SalesReturnCredit? @relation("ReturnCreditReversalJournal")",
    "returnCreditRecovery ReturnCreditRecovery?",
    "customerCreditSources CustomerCreditNote[] @relation("CustomerCreditSourceJournal")",
    "customerCreditNote CustomerCreditNote? @relation("CustomerCreditJournal")",
    "customerCreditReversal CustomerCreditNote? @relation("CustomerCreditReversalJournal")",
    "customerCreditApplication CustomerCreditApplication? @relation("CustomerCreditApplicationJournal")",
    "customerApplicationReversal CustomerCreditApplication? @relation("CustomerCreditApplicationReversalJournal")",
    "customerApplicationSources CustomerCreditApplication[] @relation("CustomerCreditApplicationSourceJournal")",
    "@@index([entryDate])",
    "@@index([referenceType, referenceId])",
    "@@index([status, entryDate])",
  ],
  "JournalLine": [
    "id String @id @default(uuid())",
    "journalEntryId String",
    "accountId String",
    "description String?",
    "debit Decimal @default(0) @db.Decimal(15, 2)",
    "credit Decimal @default(0) @db.Decimal(15, 2)",
    "currency String @default("IDR")",
    "exchangeRate Decimal @default(1) @db.Decimal(15, 6)",
    "createdAt DateTime @default(now())",
    "reconciledAt DateTime?",
    "account Account @relation(fields: [accountId], references: [id])",
    "journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)",
    "bankReconciliationItems BankReconciliationItem[]",
    "@@index([journalEntryId])",
    "@@index([accountId])",
    "@@index([accountId, reconciledAt])",
  ],
  "JournalStatus": [
    "DRAFT",
    "POSTED",
    "VOIDED",
  ],
  "MachineType": [
    "MIXER",
    "EXTRUDER",
    "REWINDER",
    "PACKER",
    "GRANULATOR",
  ],
  "MaterialIssue": [
    "id String @id @default(uuid())",
    "productionOrderId String",
    "productVariantId String",
    "quantity Decimal @db.Decimal(15, 4)",
    "status String @default("ISSUED")",
    "issuedAt DateTime @default(now())",
    "createdById String?",
    "batchId String?",
    "locationId String?",
    "batch Batch? @relation(fields: [batchId], references: [id])",
    "createdBy User? @relation(fields: [createdById], references: [id])",
    "location Location? @relation(fields: [locationId], references: [id])",
    "productVariant ProductVariant @relation(fields: [productVariantId], references: [id])",
    "productionOrder ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)",
    "additionalMaterialRequest AdditionalMaterialRequest?",
    "productionExecutionId String?",
    "productionExecution ProductionExecution? @relation(fields: [productionExecutionId], references: [id], onDelete: Restrict)",
    "stagedSourceId String?",
    "stagedSource MaterialIssue? @relation("PackagingStagedAllocation", fields: [stagedSourceId], references: [id], onDelete: Restrict)",
    "stagedAllocations MaterialIssue[] @relation("PackagingStagedAllocation")",
    "@@index([productionExecutionId])",
    "@@index([productionOrderId])",
  ],
  "MovementType": [
    "IN",
    "OUT",
    "TRANSFER",
    "ADJUSTMENT",
    "PURCHASE",
    "RETURN_IN",
    "RETURN_OUT",
  ],
  "ProductionExecution": [
    "id String @id @default(uuid())",
    "clientRequestId String? @unique",
    "requestHash String?",
    "outputGroups ProductionOutputGroup[]",
    "packagingConsumptions ProductionPackagingConsumption[]",
    "stockMovements StockMovement[]",
    "materialIssues MaterialIssue[]",
    "productionOrderId String",
    "machineId String?",
    "operatorId String?",
    "shiftId String?",
    "quantityProduced Decimal @db.Decimal(15, 4)",
    "scrapQuantity Decimal @default(0) @db.Decimal(15, 4)",
    "enteredQuantity Decimal? @db.Decimal(15, 4)",
    "enteredUnit Unit?",
    "conversionFactorSnapshot Decimal? @db.Decimal(10, 4)",
    "bruto Decimal? @db.Decimal(15, 4)",
    "bobin Decimal? @db.Decimal(15, 4)",
    "cekGram String?",
    "startTime DateTime",
    "endTime DateTime?",
    "notes String?",
    "photoUrl String? @db.Text",
    "createdAt DateTime @default(now())",
    "updatedAt DateTime @updatedAt",
    "status String @default("COMPLETED")",
    "scrapDaunQty Decimal @default(0) @db.Decimal(15, 4)",
    "scrapProngkolQty Decimal @default(0) @db.Decimal(15, 4)",
    "pieceRateSnapshot Decimal? @db.Decimal(12, 2)",
    "pieceEarnings Decimal? @db.Decimal(12, 2)",
    "pieceMachineType MachineType?",
    "machine Machine? @relation(fields: [machineId], references: [id])",
    "operator Employee? @relation("ExecutionOperator", fields: [operatorId], references: [id])",
    "helpers Employee[] @relation("ExecutionHelpers")",
    "productionOrder ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)",
    "shift ProductionShift? @relation(fields: [shiftId], references: [id])",
    "scrapRecords ScrapRecord[]",
    "qualityInspections QualityInspection[]",
    "@@index([productionOrderId])",
    "@@index([startTime])",
    "@@index([operatorId, startTime])",
  ],
  "ReferenceType": [
    "SALES_INVOICE",
    "SALES_PAYMENT",
    "PURCHASE_INVOICE",
    "PURCHASE_PAYMENT",
    "BARTER_SETTLEMENT",
    "GOODS_RECEIPT",
    "STOCK_ADJUSTMENT",
    "PRODUCTION_OUTPUT",
    "MATERIAL_ISSUE",
    "MANUAL_ENTRY",
    "SALES_RETURN",
    "PURCHASE_RETURN",
    "PETTY_CASH",
    "BANK_RECONCILIATION",
  ],
  "ScrapRecord": [
    "id String @id @default(uuid())",
    "productionOrderId String",
    "productionExecutionId String?",
    "productVariantId String",
    "quantity Decimal @db.Decimal(15, 4)",
    "reason String?",
    "recordedAt DateTime @default(now())",
    "createdById String?",
    "locationId String?",
    "createdBy User? @relation(fields: [createdById], references: [id])",
    "location Location? @relation(fields: [locationId], references: [id])",
    "productVariant ProductVariant @relation(fields: [productVariantId], references: [id])",
    "productionOrder ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)",
    "productionExecution ProductionExecution? @relation(fields: [productionExecutionId], references: [id])",
    "@@index([recordedAt])",
    "@@index([productionExecutionId])",
  ],
  "StockMovement": [
    "id String @id @default(uuid())",
    "type MovementType",
    "productVariantId String",
    "fromLocationId String?",
    "toLocationId String?",
    "quantity Decimal @db.Decimal(15, 4)",
    "reference String?",
    "createdById String?",
    "createdAt DateTime @default(now())",
    "batchId String?",
    "cost Decimal? @db.Decimal(15, 4)",
    "salesOrderId String?",
    "goodsReceiptId String?",
    "batch Batch? @relation(fields: [batchId], references: [id])",
    "createdBy User? @relation(fields: [createdById], references: [id])",
    "fromLocation Location? @relation("FromLocation", fields: [fromLocationId], references: [id])",
    "goodsReceipt GoodsReceipt? @relation("GoodsReceiptMovement", fields: [goodsReceiptId], references: [id])",
    "productVariant ProductVariant @relation(fields: [productVariantId], references: [id])",
    "salesOrder SalesOrder? @relation("SalesMovement", fields: [salesOrderId], references: [id])",
    "toLocation Location? @relation("ToLocation", fields: [toLocationId], references: [id])",
    "productionOrderId String?",
    "productionOrder ProductionOrder? @relation(fields: [productionOrderId], references: [id])",
    "returnSources SalesReturnReceiptLine[] @relation("ReturnSourceMovement")",
    "returnReceipt SalesReturnReceiptLine? @relation("ReturnReceiptMovement")",
    "additionalMaterialRequest AdditionalMaterialRequest?",
    "productionExecutionId String?",
    "productionExecution ProductionExecution? @relation(fields: [productionExecutionId], references: [id], onDelete: Restrict)",
    "reversalOfId String? @unique",
    "reversalOf StockMovement? @relation("MovementReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)",
    "reversedBy StockMovement? @relation("MovementReversal")",
    "companyOwned Boolean?",
    "packagingOwnerCustomerId String?",
    "packagingOwnerCustomer Customer? @relation("PackagingMovementOwner", fields: [packagingOwnerCustomerId], references: [id], onDelete: Restrict)",
    "outputGroup ProductionOutputGroup?",
    "packagingConsumption ProductionPackagingConsumption?",
    "internalUsage InternalUsage?",
    "atkCorrections AtkCostCorrection[] @relation("AtkCorrectionSource")",
    "atkEvidence AtkCostEvidence[]",
    "@@index([productionExecutionId])",
    "@@index([productionOrderId])",
    "@@index([productVariantId])",
    "@@index([createdAt])",
    "@@index([fromLocationId])",
    "@@index([toLocationId])",
  ],
  "Unit": [
    "KG",
    "ROLL",
    "BAL",
    "PCS",
    "ZAK",
    "KARTON",
  ],
}
